{
  "name": "supersede",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed change propagation and remediation workflows.",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19"
    }
  },
  "engines": {
    "node": ">=22.22.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "drizzle-kit migrate && SEED_ORGANIZATION_MODE=public node --conditions=react-server --import tsx scripts/seed.ts && SEED_ORGANIZATION_MODE=sandbox node --conditions=react-server --import tsx scripts/seed.ts && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:provision-runtime-role": "dotenv -e .env.local -- tsx scripts/provision-runtime-role.ts",
    "db:test": "dotenv -e .env.local -- sh -c 'psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f database/tests/foundation.sql'",
    "inngest:dev": "pnpm dlx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "eval": "vitest run tests/evals",
    "verify:live-extraction": "node --conditions=react-server --import tsx scripts/verify-live-extraction.ts",
    "verify:live-embedding": "node --conditions=react-server --import tsx scripts/verify-live-embedding.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.2",
    "@asteasolutions/zod-to-openapi": "^9.0.0",
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@google/genai": "^2.11.0",
    "@hookform/resolvers": "^5.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@sentry/nextjs": "^10.65.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@workos-inc/authkit-nextjs": "^4.2.0",
    "@workos-inc/node": "^10.7.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.12.1",
    "jszip": "3.10.1",
    "lucide-react": "^1.24.0",
    "mammoth": "1.12.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "openai": "^6.46.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "read-excel-file": "9.2.0",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "vitest": "^5.0.0"
  }
}
