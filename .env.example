# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Neon/PostgreSQL (use the pooled Neon URL in deployed environments)
DATABASE_URL=postgresql://supersede:supersede@localhost:5432/supersede

# WorkOS AuthKit
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_WEBHOOK_SECRET=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Explicit hackathon-only malware scan bypass for curated fictional files.
CURATED_DEMO_UPLOADS=false

# Cloudflare R2 working-object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=supersede-development
# Local MinIO only; omit in Cloudflare deployments.
R2_ENDPOINT=http://localhost:9000

# Amazon S3 Object Lock audit-export storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_AUDIT_BUCKET=
# Local MinIO only; omit in AWS deployments.
S3_ENDPOINT=http://localhost:9000

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5.6
APPLICATION_RELEASE_SHA=0000000000000000000000000000000000000000

# Gemini embeddings
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Postmark email delivery and authenticated delivery/bounce webhook
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_SECRET=
POSTMARK_FROM_EMAIL=

# Slack delivery (bot requires chat:write and users:read.email)
SLACK_BOT_TOKEN=

# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional HMAC signing for report manifests
REPORT_SIGNING_SECRET=
## Base64-encoded 32-byte key for learner free-text and correction submissions.
## Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Manual hackathon demo data command only
DEMO_ORGANIZATION_ID=
